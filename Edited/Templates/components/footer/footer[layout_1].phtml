<footer class="section lrs bic-f b bg-wh c-mu fse-y st-footer pt-8 pb-8">
	<div class="container">
		<div class="max gapy-5 flex-col d-flex">
			{if !$locked_for_unregistered_yn}
				{var $row_type ""}
				{if !($type == 'order-shipment' || $type == 'order-checkout' || $type == 'order-recieved')}
					{if $isBottomMenu}
						{var $row_type "row"}
					{else}
						{var $row_type "block"}
					{/if}
				{/if}
				{if !TextFieldsService::_empty('textfooter-1', $language_id)}
					<div class="text textfooter-1">{!_'textfooter-1'}</div>
				{/if}
				{if $row_type == "row"}
					<div class="row gy-5 ftr-row-1">
						<div class="col-lg-4 col-xl-3 flex-col st-footer_logo">
							<a href="{href homepage}" class="navbar-brand c-inh c-inh td-n ca-l ai-c d-inline-flex pe-a hdr-logo-media" title="{_'Home'}"><img src="https://stefeta-beta.t1.cdn-upgates.com/h/h68f0a01de7037-stafeta-white.svg" alt="Stafeta"/></a>
						</div>
						<aside class="col-lg-5 col-xl-6 ta-c ta-lg-l gapy-2 gapy-lg-1 flex-col d-flex ftr-col-right" itemscope itemtype="http://schema.org/LocalBusiness">
							<meta n:if="$owner->company" itemprop="name" content="{$owner->company}"><meta n:if="!is_null($logoFileId)" itemprop="logo" content="{image $logoFileId}"><meta n:if="!is_null($logoFileId)" itemprop="image" content="{image $logoFileId}"><meta itemprop="priceRange" content="{if $currency_id == 'EUR' || $currency_id == 'USD'}$$$$${elseif $currency_id == 'HUF'}$$$$$$${else}$$$$$${/if}"><meta itemprop="url" content="{link //Category:homepage}"><meta n:if="$owner->phone" itemprop="telephone" content="{$owner->phone}">
							<strong class="d-block tt-u mb-lg-1 ftr-adr-heading">{_'Contact us'}</strong>
							{block #cmjaausdui_address_1}
							{default $show => false}
							{if $show}
								<address class="gapx-2 gapy-1 ai-c ai-xl-s mb-1 flex-col d-flex ftr-adr-1 flex-lg-row ai-lg-s" itemprop="address" itemscope itemtype="http://schema.org/PostalAddress"><span>{if $owner->company}<span class="w-100 d-inline-block" itemprop="name">{$owner->company}</span>{/if}{if $owner->street}<span class="fs-2 d-inline-block" itemprop="streetAddress">{$owner->street}{if $owner->zip || $owner->state || $owner->country_id},&nbsp;{/if}</span>{/if}{if $owner->zip || $owner->city}<span class="fs-2 d-inline-block" itemprop="postalCode">{if $owner->zip}{$owner->zip}{/if}<span n:if="$owner->city" itemprop="addressLocality">{if $owner->zip}&nbsp;{elseif $owner->street && !$owner->zip},&nbsp;{/if}{$owner->city}</span></span>{if $owner->state || $owner->country_id},&nbsp;{/if}{/if}{if $owner->state}<span class="fs-2 d-inline-block" itemprop="addressRegion">{$owner->state}{if $owner->country_id},&nbsp;{/if}</span>{/if}{if $owner->country_name}<span class="fs-2 d-inline-block" itemprop="addressCountry" itemscope itemtype="http://schema.org/Country"><meta itemprop="name" content="{$owner->country_id|upper}">{$owner->country_name}</span>{/if}</span></address>
							{/if}
							{/block}
							{block #cmjaausdui_address_2}
							{default $show => false}
							{if $show}
								{if!TextFieldsService::_empty('second-address', $language_id)}
									<address class="gapx-2 gapy-1 ai-c ai-xl-s mb-1 flex-col d-flex ftr-adr-2 flex-lg-row ai-lg-s"><div class="text mb-all-0">{!_'second-address'}</div></address>
								{/if}
							{/if}
							{/block}
							{block #cmjaausdui_opening_hours}
							{default $show => false}
							{if $show}
								{if $owner->opening_hours}
									<div class="gapx-2 gapy-1 ai-c flex-col d-flex ftr-opn flex-lg-row"><div class="text">{!$owner->opening_hours}</div></div>
								{/if}
							{/if}
							{/block}
							{include #cmjaausdui_address_1, show => true}
							{include #cmjaausdui_address_2, show => true}
							{include #cmjaausdui_opening_hours, show => true}
							{if $owner->phone}
								<div class="gapx-2 gapy-1 ai-c flex-col d-flex ftr-phone flex-lg-row"><a href="tel:{$owner->phone|replace:' ':''}" itemprop="telephone">{$owner->phone}</a></div>
							{/if}
							{if $owner->email}
								<div class="gapx-2 gapy-1 ai-c flex-col d-flex ftr-email flex-lg-row"><a href="mailto:{$owner->email}" class="bw-y" itemprop="email">{$owner->email}</a></div>
							{/if}
							{if $writeus_active_yn}
								<div id="WriteUs" class="gapx-2 gapy-1 ai-c flex-col d-flex ftr-quick-contact ContactModal flex-lg-row" data-toggle="modal" data-target=".contactUs" data-id="{_'Quick contact'}"><a href="#" class="fg bg-de ico-sm NoScroll bov-wh-o-20 bgb-3" aria-label="{_'Write us'}"><svg class="ic" aria-hidden="true"><use href="/images/icons/fa/solid.svg?{$templateOptions['svgVersion']}#paper-plane"></use></svg></a><a href="#" class="NoScroll">{_'Quick contact'}</a></div>
							{/if}
						</aside>
						{if $isBottomMenu}
							<div class="col-lg-15 col-xl-15 ftr-col-left">
								{control bottomMenu, templateFile => '../menus/bottom.phtml'}
							</div>
						{/if}
					</div>
				{/if}
				{if $row_type == "block"}
					<aside class="ta-c gapy-2 flex-col d-flex ftr-col-contacts" itemscope itemtype="http://schema.org/LocalBusiness">
						<meta n:if="$owner->company" itemprop="name" content="{$owner->company}"><meta n:if="!is_null($logoFileId)" itemprop="logo" content="{image $logoFileId}"><meta n:if="!is_null($logoFileId)" itemprop="image" content="{image $logoFileId}"><meta itemprop="priceRange" content="{if $currency_id == 'EUR' || $currency_id == 'USD'}$$$$${elseif $currency_id == 'HUF'}$$$$$$${else}$$$$$${/if}"><meta itemprop="url" content="{link //Category:homepage}"><meta n:if="$owner->phone" itemprop="telephone" content="{$owner->phone}">
						<strong class="d-block tt-u mb-lg-1 ftr-adr-heading">{_'Contact us'}</strong>
						{block #idktynxrud_address_1}
						{default $show => false}
						{if $show}
							<address class="gapx-2 gapy-1 ai-c mb-1 flex-col d-flex ftr-adr-1" itemprop="address" itemscope itemtype="http://schema.org/PostalAddress"><span>{if $owner->company}<span class="w-100 d-inline-block" itemprop="name">{$owner->company}</span>{/if}{if $owner->street}<span class="fs-2 d-inline-block" itemprop="streetAddress">{$owner->street}{if $owner->zip || $owner->state || $owner->country_id},&nbsp;{/if}</span>{/if}{if $owner->zip || $owner->city}<span class="fs-2 d-inline-block" itemprop="postalCode">{if $owner->zip}{$owner->zip}{/if}<span n:if="$owner->city" itemprop="addressLocality">{if $owner->zip}&nbsp;{elseif $owner->street && !$owner->zip},&nbsp;{/if}{$owner->city}</span></span>{if $owner->state || $owner->country_id},&nbsp;{/if}{/if}{if $owner->state}<span class="fs-2 d-inline-block" itemprop="addressRegion">{$owner->state}{if $owner->country_id},&nbsp;{/if}</span>{/if}{if $owner->country_name}<span class="fs-2 d-inline-block" itemprop="addressCountry" itemscope itemtype="http://schema.org/Country"><meta itemprop="name" content="{$owner->country_id|upper}">{$owner->country_name}</span>{/if}</span></address>
						{/if}
						{/block}
						{block #idktynxrud_address_2}
						{default $show => false}
						{if $show}
							{if!TextFieldsService::_empty('second-address', $language_id)}
								<address class="gapx-2 gapy-1 ai-c mb-1 flex-col d-flex ftr-adr-2"><div class="text mb-all-0">{!_'second-address'}</div></address>
							{/if}
						{/if}
						{/block}
						{block #idktynxrud_opening_hours}
						{default $show => false}
						{if $show}
							{if $owner->opening_hours}
								<div class="gapx-2 gapy-1 ai-c flex-col d-flex ftr-opn"><div class="text">{!$owner->opening_hours}</div></div>
							{/if}
						{/if}
						{/block}
						{include #idktynxrud_address_1, show => true}
						{include #idktynxrud_address_2, show => true}
						{include #idktynxrud_opening_hours, show => true}
						{if $writeus_active_yn}
							<div id="WriteUs" class="gapx-2 gapy-1 ai-c flex-col d-flex ftr-quick-contact ContactModal" data-toggle="modal" data-target=".contactUs" data-id="{_'Quick contact'}"><a href="#" class="fg bg-de ico-sm NoScroll bov-wh-o-20 bgb-3" aria-label="{_'Write us'}"><svg class="ic" aria-hidden="true"><use href="/images/icons/fa/solid.svg?{$templateOptions['svgVersion']}#paper-plane"></use></svg></a><a href="#" class="NoScroll">{_'Quick contact'}</a></div>
						{/if}
<!-- Translation "textfooter-3" -->
						{if !TextFieldsService::_empty('textfooter-3', $language_id)}
							<div class="cvr-iframe text ta-c mt-1 mt-lg-2 ftr-text-3">{!_'textfooter-3'}</div>
						{/if}
					</aside>
				{/if}
				{control backlinks templateFile => 'backlinks.phtml', limit => 100}
			{/if}
		</div>
	</div>
</footer>